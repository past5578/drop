<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Image</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="bg-neutral-800">
    <main class="flex flex-col h-dvh justify-center items-center">
      <img
        class="h-3/4 w-auto border-2 border-white"
        src="{{image_url}}"
        alt=""
        width="{{image_width}}"
        height="{{image_height}}"
      />
      <div class="flex flex-row gap-2">
        <a class="text-white no-underline hover:underline" href="{{image_url}}"
          >Open Raw Image</a
        >
        <div class="w-px bg-white"></div>

        <span class="text-white">Created on {{image_created_at}}</span>
      </div>
    </main>
  </body>
</html>
